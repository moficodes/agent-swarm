# conf-gateway serves the attendee, feed and stage pages, proxies chat to
# each attendee's actor through atenet, reads actor state from ateapi with
# kubectl-ate, and forwards actor model calls to Vertex AI.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
  annotations:
    iam.gke.io/gcp-service-account: ${GATEWAY_GSA}
---
# kubectl-ate mints an ate-client token to call ateapi.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ${RBAC_PREFIX}conf-gateway-ate-client
  namespace: ate-system
rules:
- apiGroups: [""]
  resources: ["serviceaccounts/token"]
  resourceNames:
  - ate-client
  verbs: ["create"]
- apiGroups: ["discovery.k8s.io"]
  resources: ["endpointslices"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ${RBAC_PREFIX}conf-gateway-ate-client
  namespace: ate-system
subjects:
- kind: ServiceAccount
  name: conf-gateway
  namespace: ${NAMESPACE}
roleRef:
  kind: Role
  name: ${RBAC_PREFIX}conf-gateway-ate-client
  apiGroup: rbac.authorization.k8s.io
---
# kubectl-ate reads the ateapi CA from a ClusterTrustBundle.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ${RBAC_PREFIX}conf-gateway-trust-bundles
rules:
- apiGroups: ["certificates.k8s.io"]
  resources: ["clustertrustbundles"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${RBAC_PREFIX}conf-gateway-trust-bundles
subjects:
- kind: ServiceAccount
  name: conf-gateway
  namespace: ${NAMESPACE}
roleRef:
  kind: ClusterRole
  name: ${RBAC_PREFIX}conf-gateway-trust-bundles
  apiGroup: rbac.authorization.k8s.io
---
# The stage header and worker pool view read the worker pool's size from its
# HPA (or from the WorkerPool when there is no HPA) and list its worker pods.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conf-gateway-worker-scale
  namespace: ${NAMESPACE}
rules:
- apiGroups: ["autoscaling"]
  resources: ["horizontalpodautoscalers"]
  resourceNames:
  - ${WORKER_POOL}
  verbs: ["get"]
- apiGroups: ["ate.dev"]
  resources: ["workerpools"]
  resourceNames:
  - ${WORKER_POOL}
  verbs: ["get"]
- apiGroups: [""]
  resources: ["pods"]
  verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conf-gateway-worker-scale
  namespace: ${NAMESPACE}
subjects:
- kind: ServiceAccount
  name: conf-gateway
  namespace: ${NAMESPACE}
roleRef:
  kind: Role
  name: conf-gateway-worker-scale
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
  labels:
    app: conf-gateway
spec:
  # One replica: sessions, feed history and pending approvals live in memory.
  replicas: 1
  selector:
    matchLabels:
      app: conf-gateway
  template:
    metadata:
      labels:
        app: conf-gateway
    spec:
      serviceAccountName: conf-gateway
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: conf-gateway
        image: ${GATEWAY_IMAGE}
        ports:
        - name: http
          containerPort: 8090
        env:
        - name: PORT
          value: "8090"
        - name: ATESPACE
          value: "${NAMESPACE}"
        - name: WORKER_POOL_NAMESPACE
          value: "${NAMESPACE}"
        - name: WORKER_POOL_NAME
          value: "${WORKER_POOL}"
        - name: ROUTER_URL
          value: "https://atenet-router.ate-system.svc:443"
        - name: ROUTER_CA_FILE
          value: "/var/run/router-client/router-ca.pem"
        - name: ROUTER_CRED_BUNDLE
          value: "/var/run/router-client/credential-bundle.pem"
        - name: ROUTER_STATUS_DISCOVERY
          value: "endpointslices"
        - name: ATEAPI_ENDPOINT
          value: "api.ate-system.svc:443"
        - name: KUBECTL_ATE
          value: "/usr/local/bin/kubectl-ate"
        - name: VERTEX_PROJECT
          value: "${VERTEX_PROJECT}"
        - name: VERTEX_LOCATION
          value: "${VERTEX_LOCATION}"
        - name: MODEL_ALLOWLIST
          value: "gemini-3.8-flash"
        - name: DEMO_MOCK_LLM
          value: "${DEMO_MOCK_LLM}"
        - name: ACTOR_COUNT
          value: "${ACTOR_COUNT}"
        - name: ACTORS_PER_WORKER
          value: "${ACTORS_PER_WORKER}"
        - name: ALLOWED_GOOGLE_DOMAINS
          value: "${ALLOWED_GOOGLE_DOMAINS}"
        - name: GOOGLE_CLIENT_ID
          value: "${GOOGLE_CLIENT_ID}"
        - name: FIREBASE_API_KEY
          value: "${FIREBASE_API_KEY}"
        - name: CHAT_RATE_LIMIT_RPM
          value: "${CHAT_RATE_LIMIT_RPM}"
        - name: SESSION_RATE_LIMIT_RPM
          value: "${SESSION_RATE_LIMIT_RPM}"
        - name: HMAC_SECRET
          valueFrom:
            secretKeyRef:
              name: conf-gateway
              key: HMAC_SECRET
        - name: PRESENTER_TOKEN
          valueFrom:
            secretKeyRef:
              name: conf-gateway
              key: PRESENTER_TOKEN
        readinessProbe:
          httpGet:
            path: /healthz
            port: http
        resources:
          requests:
            cpu: 250m
            memory: 256Mi
          limits:
            memory: 512Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: router-client
          mountPath: /var/run/router-client
          readOnly: true
      volumes:
      - name: tmp
        emptyDir: {}
      - name: router-client
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: router-ca.pem
---
# Presenter and attendee entry point. Plain HTTP unless the install script
# also applies gateway-ingress.yaml.tmpl; see the README before exposing it.
apiVersion: v1
kind: Service
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
  annotations:
    # Used only by the GKE Ingress in gateway-ingress.yaml.tmpl, which
    # defines this BackendConfig; harmless without it.
    cloud.google.com/backend-config: '{"default":"conf-gateway"}'
spec:
  type: LoadBalancer
  selector:
    app: conf-gateway
  ports:
  - name: http
    port: 80
    targetPort: http
