# data-generator-orchestrator and data-generator-worker externalize high-scale
# audience simulation load generation across dedicated pods in the cluster.
apiVersion: v1
kind: Service
metadata:
  name: data-generator-orchestrator
  namespace: ${NAMESPACE}
  labels:
    app: data-generator-orchestrator
spec:
  selector:
    app: data-generator-orchestrator
  ports:
  - name: http
    port: 8080
    targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-generator-orchestrator
  namespace: ${NAMESPACE}
  labels:
    app: data-generator-orchestrator
spec:
  replicas: 1
  selector:
    matchLabels:
      app: data-generator-orchestrator
  template:
    metadata:
      labels:
        app: data-generator-orchestrator
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: orchestrator
        image: ${DATAGEN_ORCHESTRATOR_IMAGE}
        ports:
        - name: http
          containerPort: 8080
        env:
        - name: PORT
          value: "8080"
        resources:
          requests:
            cpu: 250m
            memory: 256Mi
          limits:
            cpu: 1000m
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-generator-worker
  namespace: ${NAMESPACE}
  labels:
    app: data-generator-worker
spec:
  replicas: ${DATAGEN_WORKER_REPLICAS}
  selector:
    matchLabels:
      app: data-generator-worker
  template:
    metadata:
      labels:
        app: data-generator-worker
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: worker
        image: ${DATAGEN_WORKER_IMAGE}
        args:
        - "-orchestrated=true"
        - "-orchestrator-url=http://data-generator-orchestrator:8080"
        env:
        - name: WORKER_CONCURRENCY
          value: "256"
        resources:
          requests:
            cpu: 500m
            memory: 256Mi
          limits:
            cpu: 2000m
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
