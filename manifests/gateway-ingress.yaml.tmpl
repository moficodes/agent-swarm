# Fronts the conf-gateway Service with a GKE-managed TLS certificate for
# DEMO_DOMAIN. Applied only when DEMO_DOMAIN is set; the gateway.yaml.tmpl
# Service works over plain HTTP without it.
apiVersion: networking.gke.io/v1
kind: ManagedCertificate
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
spec:
  domains:
  - ${DEMO_DOMAIN}
---
# Raises the load balancer's 30s default backend timeout, which would cut
# long chat turns, parked cold resumes and every SSE stream.
apiVersion: cloud.google.com/v1
kind: BackendConfig
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
spec:
  timeoutSec: 3600
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: conf-gateway
  namespace: ${NAMESPACE}
  annotations:
    networking.gke.io/managed-certificates: conf-gateway
    kubernetes.io/ingress.class: "gce"
spec:
  rules:
  - host: ${DEMO_DOMAIN}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: conf-gateway
            port:
              number: 80
