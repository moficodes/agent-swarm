apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-conf

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: conf-workers
  namespace: ate-demo-conf
  labels:
    workload: conference
spec:
  # hack/deploy.sh keeps the size the conf-workers HPA chose on a re-deploy
  # (manifests/autoscaling.yaml.tmpl).
  replicas: ${WORKER_REPLICAS}
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  template:
    # Requests let the scheduler spread workers across nodes. ateom reports
    # its limits as the worker's capacity and hosts actors until it runs
    # out. hack/deploy.sh sets the CPU limit to DEMO_CONF_ACTORS_PER_WORKER
    # CPUs plus 500m, which fits exactly that many 1-CPU actors and not one
    # more (without a limit, a worker would take the node's whole CPU). The
    # memory request covers each actor's 512Mi; there is no memory limit, so
    # a busy sandbox cannot OOM-kill a worker.
    resources:
      requests:
        cpu: 500m
        memory: ${WORKER_MEMORY_REQUEST}
      limits:
        cpu: ${WORKER_CPU_LIMIT}
