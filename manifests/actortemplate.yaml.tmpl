metadata:
  atespace: ate-demo-conf
  name: conf-agent
workerSelector:
  matchLabels:
    workload: conference
containers:
- name: conf-workload
  image: ko://github.com/agent-substrate/agent-swarm/cmd/conf-workload
  command: ["/ko-app/conf-workload"]
  # The executor runs model-generated code as nobody; handing it the
  # workspace, managing files nobody owns, and switching user need these
  # beyond substrate's defaults.
  securityContext:
    capabilities:
      add: ["CHOWN", "SETUID", "SETGID", "DAC_OVERRIDE"]
  env:
  # Read only by the install script, to refuse a stale template.
  - name: CONF_TEMPLATE_REVISION
    value: "${TEMPLATE_REVISION}"
  - name: VERTEX_PROJECT
    value: "${VERTEX_PROJECT}"
  - name: VERTEX_LOCATION
    value: "${VERTEX_LOCATION}"
  - name: GEMINI_MODEL
    value: "gemini-2.5-flash"
  - name: DEMO_MOCK_LLM
    value: "${DEMO_MOCK_LLM}"
resources:
  limits:
  - name: cpu
    quantity: "1"
  - name: memory
    quantity: 512Mi
snapshotConfig:
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/ate-demo-conf/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
