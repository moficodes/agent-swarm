metadata:
  atespace: ${NAMESPACE}
  name: ${TEMPLATE_NAME}
workerSelector:
  matchLabels:
    workload: ${WORKLOAD_LABEL}
containers:
- name: conf-workload
  image: ko://github.com/agent-substrate/agent-swarm/cmd/conf-workload
  command: ["/ko-app/conf-workload"]
  # The executor runs model-generated code as nobody; handing it the
  # workspace, managing files nobody owns, and switching user need these
  # beyond substrate's defaults.
  securityContext:
    capabilities:
      add: ["CHOWN", "SETUID", "SETGID", "DAC_OVERRIDE"]
  env:
  # Read only by the install script, to refuse a stale template.
  - name: CONF_TEMPLATE_REVISION
    value: "${TEMPLATE_REVISION}"
  - name: VERTEX_PROJECT
    value: "${VERTEX_PROJECT}"
  - name: VERTEX_LOCATION
    value: "${VERTEX_LOCATION}"
  - name: GEMINI_MODEL
    value: "gemini-3.8-flash"
  - name: DEMO_MOCK_LLM
    value: "${DEMO_MOCK_LLM}"
  - name: SANDBOX_WORKSPACE
    value: "${SANDBOX_WORKSPACE}"
  - name: MOCK_THINK_MIN_MS
    value: "${MOCK_THINK_MIN_MS}"
  - name: MOCK_THINK_MAX_MS
    value: "${MOCK_THINK_MAX_MS}"
  - name: MOCK_EXEC_MIN_MS
    value: "${MOCK_EXEC_MIN_MS}"
  - name: MOCK_EXEC_MAX_MS
    value: "${MOCK_EXEC_MAX_MS}"
resources:
  limits:
    cpuMillicores: ${ACTOR_CPU_MILLICORES}
    memoryBytes: ${ACTOR_MEMORY_BYTES}
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
